{
    "configurations": [
        {
            // Uses the debug information in the map file (build with "-debug -m").
            // Requires a DeZog version with the "z88dkv3" parser.
            "type": "dezog",
            "request": "launch",
            "name": "DeZog (map file, z88dkv3)",
            "remoteType": "cspect",
            "z88dkv3": [
                {
                    "path": "build/main.map",
                    "srcDirs": [
                        "src"
                    ],
                    "excludeFiles": []
                }
            ],
            "startAutomatically": false,
            "history": {
                "reverseDebugInstructionCount": 10000,
                "codeCoverageEnabled": false
            },
            "commandsAfterLaunch": [],
            "disassemblerArgs": {
                "numberOfLines": 20
            },
            "smartDisassemblerArgs": {
                "lowerCase": false
            },
            "rootFolder": "${workspaceFolder}",
            "topOfStack": "0xFF58",
            "load": "build/main.nex",
            "smallValuesMaximum": 513,
            "tmpDir": ".tmp"
        },
        {
            // Uses the .lis files (build with "--list --c-code-in-asm -m").
            "type": "dezog",
            "request": "launch",
            "name": "DeZog (list files, z88dkv2)",
            "remoteType": "cspect",
            "z88dkv2": [
                {
                    "path": "src/*.lis",
                    "srcDirs": [
                        "src"
                    ],
                    "mapFile": "build/main.map",
                    "excludeFiles": []
                },
            ],
            "startAutomatically": false,
            "history": {
                "reverseDebugInstructionCount": 10000,
                "codeCoverageEnabled": false
            },
            "commandsAfterLaunch": [],
            "disassemblerArgs": {
                "numberOfLines": 20
            },
            "smartDisassemblerArgs": {
                "lowerCase": false
            },
            "rootFolder": "${workspaceFolder}",
            "topOfStack": "0xFF58",
            "load": "build/main.nex",
            "smallValuesMaximum": 513,
            "tmpDir": ".tmp"
        }
    ]
}
