{
    "configurations": [
        {
            // Uses the .lis files and the map file (build with "--list --c-code-in-asm -m").
            // If the map file contains the "-debug" information (__C_LINE_ symbols)
            // it is used for the C lines (requires the DeZog branch claude/z88dk-parser-v3-on-3.7.4).
            "type": "dezog",
            "request": "launch",
            "name": "DeZog",
            "remoteType": "cspect",
            "z88dkv2": [
                {
                    "path": "src/*.lis",
                    "srcDirs": [
                        "src"
                    ],
                    "mapFile": "build/main.map",
                    "excludeFiles": []
                },
            ],
            "startAutomatically": false,
            "history": {
                "reverseDebugInstructionCount": 10000,
                "codeCoverageEnabled": false
            },
            "commandsAfterLaunch": [],
            "disassemblerArgs": {
                "numberOfLines": 20
            },
            "smartDisassemblerArgs": {
                "lowerCase": false
            },
            "rootFolder": "${workspaceFolder}",
            "topOfStack": "0xFF58",
            "load": "build/main.nex",
            "smallValuesMaximum": 513,
            "tmpDir": ".tmp"
        }
    ]
}
